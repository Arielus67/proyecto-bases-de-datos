APP_NAME="La Cuchara de Luisón"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- SQL Server (base relacional) ----------
# Ejecutar antes, en orden, los 3 scripts de database/sql/ (1_, 2_ y 3_)
DB_CONNECTION=sqlsrv
DB_HOST=localhost
DB_PORT=
DB_DATABASE=RestauranteDB
DB_USERNAME=
DB_PASSWORD=

# true solo cuando la cuenta de conexión tenga permiso IMPERSONATE sobre los usuarios app_*:
# cada petición de mesero/cocinero/cajero se ejecuta con los permisos de su rol de SQL Server.
DB_IMPERSONAR_ROLES=false
SESION_UNICA_MINUTOS=5

# Fondo de caja con el que se abre solo el turno del cajero al iniciar sesión
CAJA_MONTO_INICIAL=0

# Carpeta EN EL SERVIDOR de SQL Server donde se escriben los respaldos .bak (si no existe, SQL Server la crea)
DB_BACKUP_PATH=C:\RespaldosRestaurante\

# ---------- MongoDB (base no relacional: comandas, bitácora, tiempos de cocina) ----------
# Después de configurar: php artisan restaurante:mongo-indices
DB_MONGO_HOST=127.0.0.1
DB_MONGO_PORT=27017
DB_MONGO_DATABASE=restaurante_mongo
DB_MONGO_USERNAME=
DB_MONGO_PASSWORD=
DB_MONGO_TIMEOUT_MS=2000

# Sesión, caché y colas en archivos: no hace falta crear tablas extra en SQL Server
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@restaurante.local"
MAIL_FROM_NAME="${APP_NAME}"

